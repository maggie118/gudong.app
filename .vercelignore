sitemap.xml.static-backup
# scripts/ 下的临时诊断文件（scripts/ 目录本身保留，因为 Vercel build 要跑 refresh-listings.js）
scripts/_tmp-*
scripts/_footer-*
scripts/_*scan*
# 编辑器 / IDE 工作目录
.trae/
.trae-html-share-packages/
# 本地截图工作目录
